{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "references": [
    { "path": "packages/common" },
    { "path": "packages/routing-engine" },
    { "path": "packages/chain-adapters" },
    { "path": "packages/ledger" },
    { "path": "apps/api-service" },
    { "path": "apps/worker-service" }
  ]
}
